<style>
    * {
        box-sizing: border-box;
        margin: 0;
    }

    :root {
        --blue: #3a5bff;
        --dark: #0f1535;
    }

    body {
        font-family: Arial, sans-serif;
        color: var(--dark);
        line-height: 1.6;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .wrap {
        width: 92%;
        max-width: 1100px;
        margin: auto;
    }

    .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 0;
    }

    .logo {
        font-size: 24px;
        font-weight: bold;
        color: var(--blue);
    }

    .nav ul {
        display: flex;
        align-items: center;
        gap: 20px;
        list-style: none;
    }

    .btn {
        display: inline-block;
        padding: 10px 20px;
        background: var(--blue);
        color: white;
        border-radius: 8px;
        font-weight: bold;
    }

    .btn--ghost {
        background: white;
        color: var(--blue);
        border: 2px solid var(--blue);
    }

    .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 40px;
        padding: 60px 0;
    }

    .hero h1 {
        font-size: clamp(30px, 5vw, 50px);
        line-height: 1.2;
        margin-bottom: 15px;
    }

    .hero p {
        margin-bottom: 20px;
        color: #4b5280;
    }

    .btns {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
    }

    .hero img {
        width: 100%;
        height: auto;
        border-radius: 15px;
    }

    .features {
        background: #f2f4ff;
        padding: 50px 0;
    }

    .features h2,
    .pricing h2 {
        text-align: center;
        margin-bottom: 30px;
    }

    .features__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
    }

    .feature {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        background: white;
        padding: 20px;
        border-radius: 12px;
    }

    .feature span {
        font-size: 30px;
    }

    .pricing {
        padding-top: 50px;
        padding-bottom: 50px;
    }

    .pricing__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .plan {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 25px;
        border: 1px solid #d8dcf5;
        border-radius: 12px;
        text-align: center;
    }

    .price {
        font-size: 32px;
        font-weight: bold;
    }

    .plan .btn {
        margin-top: auto;
    }

    .plan--pop {
        border: 2px solid var(--blue);
        box-shadow: 0 10px 25px rgba(58, 91, 255, 0.2);
    }

    footer {
        background: var(--dark);
        color: #cdd2f5;
        padding: 20px 0;
    }

    footer .wrap {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

    @media (max-width: 820px) {
        .hero {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .btns {
            justify-content: center;
        }

        .pricing__grid {
            grid-template-columns: 1fr;
        }

        .nav ul {
            display: none;
        }
    }
</style>
