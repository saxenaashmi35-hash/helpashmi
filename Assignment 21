<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Example</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 20px;
        }

        header {
            background-color: lightblue;
            text-align: center;
            padding: 15px;
        }

        nav {
            background-color: #dddddd;
            padding: 10px;
            text-align: center;
        }

        nav a {
            margin: 10px;
            text-decoration: none;
            color: black;
        }

        main {
            padding: 20px;
        }

        footer {
            background-color: lightblue;
            text-align: center;
            padding: 10px;
        }
    </style>
</head>

<body>

    <header>
        <h1>Welcome to My Website</h1>
        <p>A Simple Homepage</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#contact">Contact</a>
    </nav>

    <main>
        <section id="home">
            <h2>Home</h2>
            <p>Welcome to my website. This is my first HTML homepage.</p>
        </section>

        <section id="about">
            <h2>About Us</h2>
            <p>This website is created using basic HTML and CSS.</p>
        </section>

        <section id="services">
            <h2>Our Services</h2>
            <p>We provide computer education and web designing information.</p>
        </section>

        <section id="contact">
            <h2>Contact Us</h2>
            <p>Email: example@gmail.com</p>
        </section>
    </main>

    <footer>
        <p> My Website</p>
    </footer>

</body>
</html>
