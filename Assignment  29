<!DOCTYPE html>
<html>
<head>
    <title>Hero Section</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial;
        }
        .hero {
            position: relative;
            height: 500px;
            background-color: gray;
            color: white;
            overflow: hidden;
        }
        .bg {
            position: absolute;
            width: 100%;
            height: 100%;
            z-index: 0;
        }
        .nav {
            position: absolute;
            top: 20px;
            left: 20px;
            right: 20px;
            z-index: 3;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
        }

        .nav a {
            color: white;
            text-decoration: none;
            margin-left: 15px;
        }
        .content {
            position: absolute;
            top: 40%;
            left: 20%;
            text-align: center;
            z-index: 2;
        }

        .content h1 {
            font-size: 35px;
            margin-bottom: 15px;
        }

        .content p {
            font-size: 18px;
            margin-bottom: 20px;
        }
        .btn {
            background-color: orange;
            color: white;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 20px;
        }
        .badge {
            position: absolute;
            right: 20px;
            bottom: 20px;
            z-index: 3;
            background-color: white;
            color: black;
            padding: 15px;
        }
        .fab {
            position: fixed;
            right: 20px;
            top: 50%;
            background-color: white;
            color: black;
            padding: 10px;
            text-decoration: none;
            border-radius: 50%;
        }
        .next {
            padding: 50px;
            text-align: center;
        }

    </style>
</head>
<body>
    <header class="hero">
        <img class="bg"
        src="https://picsum.photos/id/1036/1600/900">
        <nav class="nav">
            <span class="logo">TravelNest</span>

            <div>
                <a href="#">Home</a>
                <a href="#">Deals</a>
                <a href="#">Contact</a>
            </div>
        </nav>
        <div class="content">
            <h1>Find Your Next Adventure</h1>

            <p>Explore the beautiful places of the world.</p>

            <a href="#next" class="btn">Start Exploring</a>
        </div>
        <div class="badge">
            <strong>4.9 Stars</strong>
            Happy Travellers
        </div>

    </header>
    <a href="#" class="fab">↑</a>

    <!-- Next Section -->
    <section class="next" id="next">
        <h2>Popular Destinations</h2>

        <p>Welcome to our travel website.</p>
    </section>

</body>
</html>
