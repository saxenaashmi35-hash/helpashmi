<style>
    * {
        box-sizing: border-box;
        margin: 0;
    }

    body {
        font-family: Arial, sans-serif;
        background: #111;
        color: white;
        padding: 20px;
    }

    h1 {
        text-align: center;
        margin-bottom: 20px;
    }

    /* Gallery layout */
    .gallery {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: 180px;
        gap: 10px;
        max-width: 1100px;
        margin: auto;
    }

    /* Image boxes */
    figure {
        position: relative;
        overflow: hidden;
        border-radius: 10px;
    }

    img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s;
    }

    /* Hover effect */
    figure:hover img {
        transform: scale(1.08);
    }

    /* Image captions */
    figcaption {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 8px;
        background: rgba(0, 0, 0, 0.6);
    }

    /* Different image sizes */
    .wide {
        grid-column: span 2;
    }

    .tall {
        grid-row: span 2;
    }

    .big {
        grid-column: span 2;
        grid-row: span 2;
    }

    /* Tablet screen */
    @media (max-width: 800px) {
        .gallery {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* Mobile screen */
    @media (max-width: 480px) {
        .gallery {
            grid-template-columns: 1fr;
        }

        .wide, .big {
            grid-column: auto;
        }
    }
</style>
