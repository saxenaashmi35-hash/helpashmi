<title>Breakpoints Project</title>
<style>
* {
box-sizing: border-box;
margin: 0;
}
body {
font-family: system-ui, 
sans-serif; line-height: 1.6;
background: #f8f9fc;
color: #222;
} 
header { 
background: #1f3a93; 
color: #fff;
display: flex;
justify-content: space-between;
align-items: center; 
padding: 1rem 2rem;
} 
nav {
display: flex;
gap: 1.25rem;
}
nav a { 
color: #fff;
text-decoration: none;
}
main { 
max-width: 1100px;
margin: 0 auto;
padding: 2rem; 
}
.cards {
display: grid;
grid-template-columns: repeat(4, 1fr);
gap: 1.25rem;
}
.card { 
background: #fff;
padding: 1.25rem;
border-radius: 10px;
box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}
h1 {
font-size: 2.6rem;
margin-bottom: 1.5rem;
} 
.badge { 
display: inline-block;
margin-top: 1rem;
background: #ffe8cc;
padding: 0.25rem 0.75rem;
border-radius: 999px;
font-size: 0.85rem;
}
  @media (max-width: 1024px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
    h1 {
      font-size: 2.2rem;
    }
  }
  
  @media (max-width: 768px) {
    header {
      flex-direction: column;
      gap: 0.5rem;
      padding: 1rem;
    }
    main {
      padding: 1.25rem;
    }
    h1 {
      font-size: 1.9rem;
    }
  }
  
  @media (max-width: 480px) {
    .cards {
      grid-template-columns: 1fr;
    }
    nav {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
