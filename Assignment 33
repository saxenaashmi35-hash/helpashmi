body {
  margin: 0;
  font-family: system-ui, sans-serif;
  background: #f4f4f8;
}

header {
  background: #222;
  color: #fff;
  padding: 1rem 2rem;
}

.products {
  display: flex;
  flex-wrap: wrap;
  gap: 1.25rem;
  padding: 1.5rem;
  max-width: 1200px;
  margin: 0 auto;
}

.product {
  flex: 1 1 240px;
  max-width: 300px;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
}

.product img {
  width: 100%;
  height: 170px;
  object-fit: cover;
}

.product__body {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.product__body h2 {
  font-size: 1.05rem;
  margin: 0 0 0.4rem;
}

.product__body p {
  margin: 0 0 1rem;
  color: #666;
  font-size: 0.9rem;
}

.product__footer {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  font-weight: 700;
  font-size: 1.1rem;
}

button {
  background: #ff6b35;
  color: #fff;
  border: 0;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  cursor: pointer;
}
