<style>
    :root {
        --cream: #fbf5ec;
        --brown: #4a2c1a;
        --green: #5b8c5a;
        --gold: #d99a2b;
        --radius: 14px;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: Georgia, serif;
        background: var(--cream);
        color: var(--brown);
        line-height: 1.6;
    }

    img {
        width: 100%;
        display: block;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    .wrap {
        width: 92%;
        max-width: 1150px;
        margin: auto;
    }

    .btn {
        display: inline-block;
        background: var(--gold);
        color: white;
        padding: 12px 25px;
        border-radius: 30px;
        font-weight: bold;
    }

    h2 {
        font-size: 32px;
        text-align: center;
        margin-bottom: 30px;
    }

    .site-header {
        padding: 20px 0;
    }

    .site-header .wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo {
        font-size: 25px;
        font-weight: bold;
        color: var(--green);
    }

    .site-nav ul {
        display: flex;
        gap: 25px;
        list-style: none;
    }

    .hero .wrap {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: center;
        padding: 60px 0;
    }

    .hero h1 {
        font-size: 50px;
        line-height: 1.2;
        margin-bottom: 15px;
    }

    .hero p {
        margin-bottom: 25px;
        font-size: 18px;
    }

    .hero img {
        height: 400px;
        object-fit: cover;
        border-radius: var(--radius);
    }

    .menu {
        padding: 60px 0;
        background: white;
    }

    .menu__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .dish {
        background: var(--cream);
        border-radius: var(--radius);
        overflow: hidden;
    }

    .dish img {
        height: 200px;
        object-fit: cover;
    }

    .dish__body {
        padding: 20px;
    }

    .dish__row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
    }

    .dish__price {
        color: var(--green);
        font-weight: bold;
    }

    .about {
        padding: 60px 0;
    }

    .about .wrap {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: center;
    }

    .about img {
        border-radius: var(--radius);
    }

    .about h2 {
        text-align: left;
    }

    .contact {
        background: var(--green);
        color: white;
        padding: 50px 0;
        text-align: center;
    }

    .contact .btn {
        margin-top: 20px;
    }

    .site-footer {
        padding: 25px 0;
    }

    .site-footer .wrap {
        display: flex;
        justify-content: space-between;
        gap: 15px;
    }

    @media (max-width: 768px) {
        .hero .wrap,
        .about .wrap {
            grid-template-columns: 1fr;
        }

        .hero h1 {
            font-size: 36px;
        }

        .menu__grid {
            grid-template-columns: 1fr;
        }

        .site-header .wrap {
            flex-direction: column;
            gap: 15px;
        }

        .site-nav ul {
            gap: 15px;
        }

        .site-footer .wrap {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
    }
</style>
