<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Registration Form</title>
</head>
<body>
      <h2> Registration Form</h2>
      <form>
        <label for="name"> Name: </label>
        <input type="text" id="name" placeholder="Enter your name here">
        <br>
        <label for="course"> Course:</label>
        <select id="course">
          <option> BCA </option>
          <option> BCA(AI)</option>
          <option> B.Tech</option>
          <option> Fashion Designing</option>
          <option> BBA</option>
          <option> BALLb</option>
        </select> <br>
        <label for="age"> Age:</label>
        <input type="number" min=16 max=100 placeholder="Your age">
        <br>
        <label for="semyear"> Semester Year: </label>
        <select>
          <option> I </option>
          <option> II</option>
          <option> III</option>
          <option> IV</option>
          <option> V</option>
        </select>
        <br>
        <label for="gen"> Gender:</label>
        <label><input type="radio" id="gen" value="Male">
          Male </label>
        <label><input type="radio" id="gen" value="Female"> Female </label>
        <br>
        <label for="email"> Email:</label>
        <input type="email" id="email" placeholder="Enter your email here" required>
        <br>
        <button type="submit"> Submit</button>

      </form>
  </body>
</html>
