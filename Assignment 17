<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Application Form</title>
</head>
<body>
      <h2>Job Application Form</h2>
      <form>
        <label for="name"> Name: </label>
        <input type="text" id="name" placeholder="Enter your name here">
        <br>
        <label for="position"> Position:</label>
        <select id="position">
          <option> Backend developer </option>
          <option> Frontend developer</option>
          <option> Web designer</option>
          <option> AI trainer</option>
          <option> Stack developer</option>
        </select> <br>
        <label for="age"> Age:</label>
        <input type="number" min=20 max=100 placeholder="Your age">
        <br>
        <label for="num"> Phone number: </label>
        <input type="tel" id="num" placeholder="Enter your number here required">
        <br>
        <label for="gen"> Gender:</label>
        <label><input type="radio" id="gen" value="Male">
          Male </label>
        <label><input type="radio" id="gen" value="Female"> Female </label>
        <br>
        <label for="email"> Email:</label>
        <input type="email" id="email" placeholder="Enter your email here" required>
        <br>
        <label for="exp"> Experience:</label>
        <select>
          <option> No Experience</option>
          <option> 1 Year Experience</option>
          <option> 2 Year Experience</option>
          <option> 3 Year Experience</option>
          <option> More than 3 Year Experience</option>
        </select>
        <br>
        <button type="submit"> Submit</button>
      </form>
  </body>
</html>
